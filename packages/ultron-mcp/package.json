{
  "name": "@ultron/appium-mcp-plugin",
  "version": "0.1.0",
  "description": "Standalone MCP for the Android Ultron HTTP server, with an optional Appium MCP plugin",
  "bugs": {
    "url": "https://github.com/dabrynskiy/ultron-omni-driver/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dabrynskiy/ultron-omni-driver.git",
    "directory": "packages/ultron-mcp"
  },
  "bin": {
    "ultron-mcp": "./bin/ultron-mcp.mjs"
  },
  "files": [
    "index.mjs",
    "direct-client.mjs",
    "standalone.mjs",
    "lifecycle.mjs",
    "snapshot-match.mjs",
    "compose.mjs",
    "bin",
    "examples",
    "README.md",
    "NOTICE"
  ],
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": {
      "default": "./index.mjs"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:host": "node test/host-smoke.mjs",
    "test:android": "node test/android-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "appium-mcp": ">=1.99.2 <2"
  },
  "peerDependenciesMeta": {
    "appium-mcp": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
